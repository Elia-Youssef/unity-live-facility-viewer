<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/BootstrapShell.uss?fileID=7433441132597879392&amp;guid=7428543fddd099f47864cb7d32442916&amp;type=3#BootstrapShell" />
    <Style src="project://database/Assets/UI/Styles/FacilityPanelBase.uss" />
    <Style src="project://database/Assets/UI/Styles/FacilityPanelComponents.uss" />
    <Style src="project://database/Assets/UI/Styles/FacilityPanelResponsive.uss" />
    <Style src="project://database/Assets/UI/Styles/TeleportPadPrompt.uss" />
    <ui:Template name="FacilitySectionHeading" src="project://database/Assets/UI/Templates/FacilitySectionHeading.uxml" />
    <ui:VisualElement name="app-shell" class="app-shell">
        <ui:VisualElement name="app-safe-area" class="app-safe-area">
            <ui:VisualElement name="facility-panel" class="facility-panel">
            <ui:VisualElement name="facility-panel-header" class="facility-panel__header">
                <ui:VisualElement name="facility-panel-identity" class="facility-panel__identity">
                    <ui:Label name="application-name-label" text="Live Facility Viewer" class="title panel-title" />
                    <ui:Label name="current-level-label" text="CURRENT AREA  /  Starting..." class="current-level" />
                </ui:VisualElement>
                <ui:Button name="close-panel-button" text="CLOSE" tooltip="Return to facility view" class="panel-close-button" />
            </ui:VisualElement>
            <ui:VisualElement name="level-navigation-section" class="facility-section facility-section--levels">
                <ui:Instance template="FacilitySectionHeading" name="level-navigation-heading">
                    <ui:AttributeOverrides element-name="section-heading-label" text="LEVEL NAVIGATION" />
                </ui:Instance>
                <ui:VisualElement name="level-buttons" class="facility-section__content level-buttons" />
            </ui:VisualElement>
            <ui:VisualElement name="theme-selection-section" class="facility-section facility-section--themes">
                <ui:Instance template="FacilitySectionHeading" name="theme-selection-heading">
                    <ui:AttributeOverrides element-name="section-heading-label" text="VISUAL THEME" />
                </ui:Instance>
                <ui:VisualElement name="theme-buttons" class="facility-section__content facility-section__controls theme-buttons">
                    <ui:Button name="theme-standard-button" text="STANDARD (UNAVAILABLE)" tooltip="Theme switching is unavailable until a theme service is configured." class="state-button theme-button" />
                    <ui:Button name="theme-maintenance-button" text="MAINTENANCE (UNAVAILABLE)" tooltip="Theme switching is unavailable until a theme service is configured." class="state-button theme-button" />
                    <ui:Button name="theme-emergency-button" text="EMERGENCY (UNAVAILABLE)" tooltip="Theme switching is unavailable until a theme service is configured." class="state-button state-button--last theme-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="lighting-controls-section" class="facility-section facility-section--lighting">
                <ui:Instance template="FacilitySectionHeading" name="lighting-controls-heading">
                    <ui:AttributeOverrides element-name="section-heading-label" text="LIGHTING" />
                </ui:Instance>
                <ui:VisualElement name="lighting-buttons" class="facility-section__content facility-section__controls lighting-buttons">
                    <ui:Button name="lighting-ambient-button" text="AMBIENT (UNAVAILABLE)" tooltip="Lighting controls are unavailable until a light-group service is configured." class="state-button lighting-button" />
                    <ui:Button name="lighting-operations-button" text="OPERATIONS (UNAVAILABLE)" tooltip="Lighting controls are unavailable until a light-group service is configured." class="state-button lighting-button" />
                    <ui:Button name="lighting-emergency-button" text="EMERGENCY (UNAVAILABLE)" tooltip="Lighting controls are unavailable until a light-group service is configured." class="state-button state-button--last lighting-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="system-status-section" class="facility-section facility-section--status">
                <ui:Instance template="FacilitySectionHeading" name="system-status-heading">
                    <ui:AttributeOverrides element-name="section-heading-label" text="SYSTEM STATUS" />
                </ui:Instance>
                <ui:VisualElement name="system-status-content" class="facility-section__content system-status">
                    <ui:Label name="connection-status-label" text="CONNECTION  /  LOCAL" class="system-status__summary" />
                    <ui:Label name="control-availability-label" text="CONTROL SERVICES  /  THEME AND LIGHTING UNAVAILABLE" class="system-status__summary control-availability" />
                    <ui:Label name="transition-phase-label" text="PHASE  /  STARTING" class="transition-phase" />
                    <ui:Label name="transition-status-label" text="Application services starting" class="transition-status" />
                </ui:VisualElement>
            </ui:VisualElement>
                <ui:Label text="TAB closes this panel" class="panel-hint" />
            </ui:VisualElement>
            <ui:VisualElement name="status-card" class="status-card">
                <ui:Label text="FACILITY SYSTEM" class="eyebrow" />
                <ui:Label name="title-label" text="Live Facility Viewer" class="title" />
                <ui:Label name="status-label" text="Checking project foundation..." class="status" />
            </ui:VisualElement>
            <ui:VisualElement name="teleport-prompt" picking-mode="Ignore" class="teleport-prompt">
                <ui:Label name="teleport-prompt-action-label" text="" picking-mode="Ignore" class="teleport-prompt__action" />
                <ui:Label name="teleport-prompt-destination-label" text="" picking-mode="Ignore" class="teleport-prompt__destination" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="loading-overlay" class="loading-overlay" picking-mode="Position">
            <ui:VisualElement class="loading-card">
                <ui:Label text="FACILITY TRANSITION" class="panel-eyebrow" />
                <ui:Label name="loading-status-label" text="Loading facility..." class="loading-status" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
